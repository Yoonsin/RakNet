#include <linux/skbuff.h>
#include <linux/ip.h>
#include <linux/udp.h>
#include <net/sock.h> // sock 구조체를 위해 추가

/* QoSAgent.sh가 주입 */
#ifndef SERVER_IP_BE32
# define SERVER_IP_BE32 0
#endif
#ifndef SERVER_PORT_BE16
# define SERVER_PORT_BE16 0
#endif

BEGIN {
    @server_info["ip"] = SERVER_IP_BE32;
    @server_info["port"] = SERVER_PORT_BE16;
}

/* EGRESS: kprobe로 변경 */
kprobe:ip_queue_xmit {
    // kprobe에서는 skb가 첫 번째 인자(arg0)로 들어옵니다.
    struct sk_buff *skb = (struct sk_buff *)arg0;
    struct sock *sk = (struct sock *)skb->sk;

    // 헤더 접근 방식 변경: skb->data가 IP 헤더의 시작점입니다.
    struct iphdr  *iph  = (struct iphdr *)skb->data;
    
    // IP 헤더 길이(ihl)를 이용해 UDP 헤더 위치 계산
    struct udphdr *udph = (struct udphdr *)(skb->data + (iph->ihl << 2));

    if (iph->protocol != IPPROTO_UDP) {
        exit();
    }
    
    // 디버깅 프린트
    printf("[DEBUG EGRESS] saddr: %s, sport: %u -> daddr: %s, dport: %u, proto: %d\n",
        ntop(iph->saddr), bswap(udph->source),
        ntop(iph->daddr), bswap(udph->dest), iph->protocol);

    if ((udph->source == SERVER_PORT_BE16 || udph->dest == SERVER_PORT_BE16) &&
        (iph->saddr  == SERVER_IP_BE32    || iph->daddr == SERVER_IP_BE32)) {
        @bytes_egress[iph->saddr, udph->source, iph->daddr, udph->dest] = sum(skb->len);
        @pkts_egress [iph->saddr, udph->source, iph->daddr, udph->dest] = count();
        @bytes_win   [iph->saddr, udph->source, iph->daddr, udph->dest] = sum(skb->len);
        @pkts_win    [iph->saddr, udph->source, iph->daddr, udph->dest] = count();
    }
}

/* INGRESS: kprobe로 변경 */
kprobe:ip_rcv {
    struct sk_buff *skb = (struct sk_buff *)arg0;
    struct iphdr  *iph  = (struct iphdr *)skb->data;
    struct udphdr *udph = (struct udphdr *)(skb->data + (iph->ihl << 2));

    if (iph->protocol != IPPROTO_UDP) {
        exit();
    }
    
    printf("[DEBUG INGRESS] saddr: %s, sport: %u -> daddr: %s, dport: %u, proto: %d\n",
        ntop(iph->saddr), bswap(udph->source),
        ntop(iph->daddr), bswap(udph->dest), iph->protocol);

    if ((udph->source == SERVER_PORT_BE16 || udph->dest == SERVER_PORT_BE16) &&
        (iph->saddr  == SERVER_IP_BE32    || iph->daddr == SERVER_IP_BE32)) {
        @bytes_ingress[iph->saddr, udph->source, iph->daddr, udph->dest] = sum(skb->len);
        @pkts_ingress [iph->saddr, udph->source, iph->daddr, udph->dest] = count();
        @bytes_win    [iph->saddr, udph->source, iph->daddr, udph->dest] = sum(skb->len);
        @pkts_win     [iph->saddr, udph->source, iph->daddr, udph->dest] = count();
    }
}

/* 누적 출력 */
END {
  printf("\n--- TOTAL egress bytes ---\n");  print(@bytes_egress);
  printf("\n--- TOTAL egress pkts  ---\n");  print(@pkts_egress);
  printf("\n--- TOTAL ingress bytes ---\n"); print(@bytes_ingress);
  printf("\n--- TOTAL ingress pkts  ---\n"); print(@pkts_ingress);

  $ip_be32 = @server_info["ip"];
  $port_be16 = @server_info["port"];

  printf("\n--- Server Info ---\n");
  // ntop() 함수로 IP 주소 변환
    // 해결책 1: ntop() 대신 IP 주소를 수동으로 파싱하여 출력
  $a = ($ip_be32 >> 24) & 0xFF;
  $b = ($ip_be32 >> 16) & 0xFF;
  $c = ($ip_be32 >> 8) & 0xFF;
  $d = $ip_be32 & 0xFF;
  printf("SERVER_IP   : %d.%d.%d.%d\n", $a, $b, $c, $d);
 
  // bswap() 함수로 포트 번호의 바이트 순서를 뒤집어 원래 값으로 변환
  // 해결책: bswap() 대신 수동으로 비트 연산 수행
  // ($port_be16 & 0xFF) << 8  : 하위 8비트를 상위로 이동
  // ($port_be16 >> 8) & 0xFF    : 상위 8비트를 하위로 이동
  printf("SERVER_PORT : %u\n", (($port_be16 & 0x00FF) << 8) | (($port_be16 >> 8) & 0x00FF));

  clear(@server_info);
}