{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Solution (Debug)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "IrrlichtDemo.v8_Server.sln",
                "/p:Configuration=Debug",
                "/p:Platform=Win32"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build Solution (Release)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "IrrlichtDemo.v8_Server.sln",
                "/p:Configuration=Release",
                "/p:Platform=Win32"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}